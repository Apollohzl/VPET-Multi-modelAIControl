{
  "name": "BodianMusicSongNameSearchList",
  "description": "\u6CE2\u70B9\u97F3\u4E50\u6B4C\u66F2\u5217\u8868\u641C\u7D22\uFF0C\u80FD\u591F\u8FD4\u56DE\u641C\u7D22\u5230\u7684\u6240\u6709\u6B4C\u66F2\u7684\u4FE1\u606F",
  "summary": "\u6CE2\u70B9\u97F3\u4E50\u641C\u7D22",
  "parameters": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "defaultValue": "",
      "description": "\u6B4C\u66F2\u540D\u5B57\uFF0C\u4E0D\u4E3A\u7A7A"
    }
  ],
  "code": "// ====== \u5DE5\u5177\u6267\u884C\u4EE3\u7801\u7F16\u5199\u8BF4\u660E ======\n// \u51FD\u6570\u7B7E\u540D\uFF1Apublic async Task\u003Cstring\u003E Execute(Dictionary\u003Cstring, object\u003E args)\n// - args[\u0022\u53C2\u6570\u540D\u0022] \u83B7\u53D6 AI \u4F20\u5165\u7684\u53C2\u6570\u503C\n// - \u8FD4\u56DE string \u7C7B\u578B\u7ED3\u679C\u7ED9 AI\n//\n// \u53EF\u7528 API\uFF1A\n// - System.IO\uFF1A\u6587\u4EF6\u8BFB\u5199\u64CD\u4F5C\n// - System.Diagnostics.Process\uFF1A\u542F\u52A8\u8FDB\u7A0B/\u6253\u5F00\u7F51\u9875\n// - System.Net.Http.HttpClient\uFF1A\u7F51\u7EDC\u8BF7\u6C42\n// - System.Text.Json\uFF1AJSON \u5904\u7406\n// - System.Text.RegularExpressions\uFF1A\u6B63\u5219\u5339\u914D\n//\n// \u793A\u4F8B\uFF1A\u6253\u5F00\u7F51\u9875\n// public async Task\u003Cstring\u003E Execute(Dictionary\u003Cstring, object\u003E args)\n// {\n//     var url = args[\u0022url\u0022]?.ToString();\n//     System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo\n//     {\n//         FileName = url,\n//         UseShellExecute = true\n//     });\n//     return $\u0022\u5DF2\u6253\u5F00\u7F51\u9875: {url}\u0022;\n// }\n// ================================\n\npublic async Task\u003Cstring\u003E Execute(Dictionary\u003Cstring, object\u003E args)\n{\n    // \u8BFB\u53D6 AI \u4F20\u5165\u7684\u53C2\u6570\n    var name = args[\u0022name\u0022]?.ToString();\n    if (string.IsNullOrWhiteSpace(name))\n        return \u0022{\\\u0022error\\\u0022:\\\u0022missing parameter: name\\\u0022}\u0022;\n\n    // \u6784\u9020\u8BF7\u6C42 URL\uFF08\u5BF9 name \u505A URL \u7F16\u7801\uFF09\n    var encodedName = Uri.EscapeDataString(name);\n    var url = $\u0022https://api.xingzhige.com/API/Kuwo_BD_new/?name={encodedName}\u0022;\n\n    using (var httpClient = new System.Net.Http.HttpClient())\n    {\n        httpClient.Timeout = TimeSpan.FromSeconds(20);\n\n        var response = await httpClient.GetAsync(url);\n        var content = await response.Content.ReadAsStringAsync();\n\n        // \u76F4\u63A5\u8FD4\u56DE\u8FD4\u56DE\u7684 JSON \u5185\u5BB9\uFF08\u65E0\u8BBA\u72B6\u6001\u7801\u662F\u5426 2xx\uFF0C\u90FD\u8FD4\u56DE\u54CD\u5E94\u4F53\uFF09\n        // \u5982\u9700\u4E25\u683C\u53EA\u8FD4\u56DE\u6210\u529F\uFF0C\u53EF\u628A\u4E0B\u9762\u4E24\u884C\u6539\u4E3A\uFF1Aif (!response.IsSuccessStatusCode) return content;\n        return content;\n    }\n}"
}